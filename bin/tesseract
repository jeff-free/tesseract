#!/usr/bin/env bash
set -euo pipefail

TESSERACT_HOME="$(cd "$(dirname "$0")/.." && pwd)"
SCRIPTS_DIR="$TESSERACT_HOME/scripts"

usage() {
    echo "用法: tesseract <指令> [參數]"
    echo ""
    echo "指令:"
    echo "  init                  初始化 Tesseract 設定"
    echo "  new-domain <名稱>     建立新的知識 domain"
    echo "  link <專案路徑> <domain>  將 domain 連結到專案"
    echo "  status                列出所有 domain 與連結狀態"
    echo "  reindex               重新產生各 domain 的 summary.md"
    echo "  help                  顯示此說明"
}

command="${1:-help}"
shift || true

case "$command" in
    init)        bash "$SCRIPTS_DIR/init.sh" "$@" ;;
    new-domain)  bash "$SCRIPTS_DIR/new-domain.sh" "$@" ;;
    link)        bash "$SCRIPTS_DIR/link.sh" "$@" ;;
    status)      bash "$SCRIPTS_DIR/status.sh" "$@" ;;
    reindex)     bash "$SCRIPTS_DIR/reindex.sh" "$@" ;;
    help|--help|-h) usage ;;
    *)
        echo "錯誤：不認識的指令 '$command'" >&2
        echo ""
        usage
        exit 1
        ;;
esac
