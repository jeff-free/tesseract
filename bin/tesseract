#!/usr/bin/env bash
set -euo pipefail

TESSERACT_HOME="$(cd "$(dirname "$0")/.." && pwd)"
SCRIPTS_DIR="$TESSERACT_HOME/scripts"

usage() {
    echo "用法: tesseract <指令> [參數]"
    echo ""
    echo "指令:"
    echo "  init                         初始化 Tesseract 設定"
    echo "  new <名稱> [路徑]            建立專案資料夾 + iCloud 知識庫 + 連結（一步完成）"
    echo "  link <專案路徑> <domain>     將現有專案連結到現有知識 domain"
    echo "  new-domain <名稱>            僅建立 iCloud 知識 domain（進階用）"
    echo "  install-adapters             安裝/更新各 AI 的 global skill"
    echo "  status                       列出所有 domain 與連結狀態"
    echo "  reindex                      重建各 domain 的 index.md Files 清單"
    echo "  help                         顯示此說明"
}

command="${1:-help}"
shift || true

case "$command" in
    init)              bash "$SCRIPTS_DIR/init.sh" "$@" ;;
    new)               bash "$SCRIPTS_DIR/new.sh" "$@" ;;
    new-domain)        bash "$SCRIPTS_DIR/new-domain.sh" "$@" ;;
    link)              bash "$SCRIPTS_DIR/link.sh" "$@" ;;
    install-adapters)  bash "$SCRIPTS_DIR/install-adapters.sh" "$@" ;;
    status)            bash "$SCRIPTS_DIR/status.sh" "$@" ;;
    reindex)           bash "$SCRIPTS_DIR/reindex.sh" "$@" ;;
    help|--help|-h) usage ;;
    *)
        echo "錯誤：不認識的指令 '$command'" >&2
        echo ""
        usage
        exit 1
        ;;
esac
