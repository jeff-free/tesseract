#!/usr/bin/env bash
set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SERVER_RB="$SCRIPT_DIR/../mcp/server.rb"

# Find a Ruby 3.0+ binary
find_ruby() {
    local candidates=()

    # 1. rbenv
    if command -v rbenv >/dev/null 2>&1; then
        candidates+=("$(rbenv which ruby 2>/dev/null || true)")
    fi
    if [ -x "$HOME/.rbenv/shims/ruby" ]; then
        candidates+=("$HOME/.rbenv/shims/ruby")
    fi

    # 2. asdf / mise
    if command -v asdf >/dev/null 2>&1; then
        candidates+=("$(asdf which ruby 2>/dev/null || true)")
    fi
    if command -v mise >/dev/null 2>&1; then
        candidates+=("$(mise which ruby 2>/dev/null || true)")
    fi

    # 3. Homebrew
    if [ -x "/opt/homebrew/bin/ruby" ]; then
        candidates+=("/opt/homebrew/bin/ruby")
    fi
    if [ -x "/usr/local/bin/ruby" ]; then
        candidates+=("/usr/local/bin/ruby")
    fi

    # 4. PATH ruby
    if command -v ruby >/dev/null 2>&1; then
        candidates+=("$(which ruby)")
    fi

    for candidate in "${candidates[@]}"; do
        if [ -n "$candidate" ] && [ -x "$candidate" ]; then
            if "$candidate" -e 'exit(RUBY_VERSION >= "3.0.0" ? 0 : 1)' 2>/dev/null; then
                echo "$candidate"
                return 0
            fi
        fi
    done

    return 1
}

RUBY_BIN=$(find_ruby || true)

if [ -z "$RUBY_BIN" ]; then
    echo "[Tesseract MCP] Error: Ruby 3.0.0 or higher is required to run Tesseract MCP." >&2
    echo "[Tesseract MCP] Please install Ruby >= 3.0 via rbenv, asdf, mise, or Homebrew (brew install ruby)." >&2
    exit 1
fi

exec "$RUBY_BIN" "$SERVER_RB" "$@"
